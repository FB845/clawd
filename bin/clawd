#!/bin/sh
# Command-line client for Clawd. Forwards to the app, which does the real work:
#   bin/clawd notify "Build finished"      (run `bin/clawd help` for the rest)
# Silently does nothing if the app can't be found, so hooks never fail.
[ $# -eq 0 ] && set -- help
here="$(cd "$(dirname "$0")" && pwd)"
for app in "$here/../build/Clawd.app" "/Applications/Clawd.app" "$HOME/Applications/Clawd.app"; do
    if [ -x "$app/Contents/MacOS/Clawd" ]; then
        exec "$app/Contents/MacOS/Clawd" "$@"
    fi
done
exit 0
