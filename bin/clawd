#!/usr/bin/env python3
"""Talk to the Clawd desktop pet.

  clawd notify "message"       speech bubble + little hop
  clawd say "message"          speech bubble only
  clawd thinking | done | attention | clear
  clawd tool bash|edit|read|web|agent
  clawd pet | sleep | wake | snack
  clawd ball [classic|baseball|basketball|soccer|tennis]
  clawd hook                   read a Claude Code hook payload on stdin

Silently does nothing if Clawd isn't running. Always exits 0.
"""
import hashlib
import json
import os
import socket
import sys

SOCK = "/tmp/clawd.sock"

TOOL_KINDS = {
    "Bash": "bash", "PowerShell": "bash",
    "Edit": "edit", "Write": "edit", "MultiEdit": "edit", "NotebookEdit": "edit",
    "Read": "read", "Grep": "read", "Glob": "read", "LS": "read",
    "WebFetch": "web", "WebSearch": "web",
    "Agent": "agent", "Task": "agent",
}


def send(obj):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.5)
        s.connect(SOCK)
        s.sendall((json.dumps(obj) + "\n").encode("utf-8"))
        s.close()
    except OSError:
        pass


# How long a permission request waits for a click on Clawd before Claude Code's own prompt takes over.
APPROVAL_WAIT = float(os.environ.get("CLAWD_APPROVAL_TIMEOUT", "120"))


def request_key(payload):
    """Identifies one tool call so Clawd can drop its card once the call is settled elsewhere."""
    blob = json.dumps([payload.get("tool_name", ""), payload.get("tool_input", {})], sort_keys=True, default=str)
    return hashlib.sha1(blob.encode("utf-8")).hexdigest()[:16]


def describe(tool, inp):
    """Short, human-readable summary of what the tool is about to do."""
    if not isinstance(inp, dict):
        return ""
    home = os.path.expanduser("~")

    def path(p):
        p = str(p or "")
        return "~" + p[len(home):] if p.startswith(home) else p

    if tool in ("Bash", "PowerShell"):
        return str(inp.get("command", ""))
    if tool in ("Edit", "MultiEdit", "Write", "Read", "NotebookEdit"):
        return path(inp.get("file_path") or inp.get("notebook_path"))
    if tool == "WebFetch":
        return str(inp.get("url", ""))
    if tool == "WebSearch":
        return str(inp.get("query", ""))
    if tool in ("Glob", "Grep"):
        return "%s  %s" % (inp.get("pattern", ""), path(inp.get("path", "")))
    if tool in ("Agent", "Task"):
        return str(inp.get("description", ""))
    for v in inp.values():   # MCP and others: first short string argument
        if isinstance(v, str) and v.strip():
            return v
    return json.dumps(inp, default=str)[:200]


def pretty_tool(tool):
    if tool.startswith("mcp__"):
        parts = tool.split("__")
        return parts[-1].replace("_", " ") if len(parts) >= 3 else tool
    return tool or "this tool"


def ask_clawd(payload):
    """Shows the request on Clawd and waits for a click. Returns True, False, or None (no answer)."""
    tool = payload.get("tool_name", "")
    req = {
        "event": "approval_request",
        "tool": pretty_tool(tool),
        "detail": describe(tool, payload.get("tool_input", {}))[:400],
        "project": os.path.basename(str(payload.get("cwd", "")).rstrip("/")),
        "session": payload.get("session_id", ""),
        "key": request_key(payload),
    }
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.5)
        s.connect(SOCK)
        s.sendall((json.dumps(req) + "\n").encode("utf-8"))
        s.settimeout(APPROVAL_WAIT)
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(4096)
            if not chunk:
                return None   # Clawd dropped the card (answered elsewhere, or quit)
            buf += chunk
        s.close()
        decision = json.loads(buf.decode("utf-8")).get("decision")
        return {"allow": True, "deny": False}.get(decision)
    except (OSError, ValueError):
        return None


# These "permission" prompts are really questions or plan reviews that need your actual answer.
# Allowing them from Clawd would skip that answer, so Clawd only points you to Claude Code.
NEEDS_YOU = {
    "AskUserQuestion": "Claude has a question for you",
    "ExitPlanMode": "A plan is ready for your review",
}


def kind_for(tool):
    if not tool:
        return "other"
    return TOOL_KINDS.get(tool, "other")


def hook():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return
    ev = payload.get("hook_event_name", "")
    tool = payload.get("tool_name", "")
    if ev == "UserPromptSubmit":
        send({"event": "thinking"})
    elif ev == "PreToolUse":
        send({"event": "tool", "tool": kind_for(tool)})
    elif ev in ("PostToolUse", "PostToolUseFailure"):
        send({"event": "resolved", "session": payload.get("session_id", ""), "key": request_key(payload)})
        send({"event": "thinking"})
    elif ev == "PermissionRequest":
        if tool in NEEDS_YOU:
            send({"event": "attention", "message": NEEDS_YOU[tool]})
            return   # no decision: Claude Code shows its own prompt
        answer = ask_clawd(payload)
        if answer is True:
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest",
                                                     "decision": {"behavior": "allow"}}}))
        elif answer is False:
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest",
                                                     "decision": {"behavior": "deny",
                                                                  "message": "Denied from Clawd.",
                                                                  "interrupt": False}}}))
        # No answer: print nothing, and Claude Code shows its normal prompt.
    elif ev == "Notification":
        ntype = payload.get("notification_type", "") or ""
        msg = (payload.get("message", "") or "")[:140]
        low = msg.lower()
        if ntype == "permission_prompt" or "permission" in low:
            send({"event": "attention", "message": "Needs your permission"})
        elif ntype == "idle_prompt" or "waiting" in low:
            send({"event": "attention", "message": "Waiting for you"})
        elif msg:
            send({"event": "notify", "message": msg})
    elif ev == "Stop":
        send({"event": "done", "session": payload.get("session_id", "")})
    elif ev == "SessionEnd":
        send({"event": "clear", "session": payload.get("session_id", "")})


def main(argv):
    if len(argv) < 2:
        print(__doc__.strip())
        return
    cmd = argv[1]
    rest = " ".join(argv[2:]).strip()
    if cmd == "hook":
        hook()
    elif cmd in ("notify", "say"):
        send({"event": cmd, "message": rest or "Ping!"})
    elif cmd == "ball":
        msg = {"event": "ball"}
        if rest:
            msg["kind"] = rest.split()[0].lower()
        send(msg)
    elif cmd == "tool":
        send({"event": "tool", "tool": rest or "other"})
    elif cmd in ("thinking", "done", "attention", "clear", "pet", "sleep", "wake", "snack"):
        msg = {"event": cmd}
        if rest:
            msg["message"] = rest
        send(msg)
    else:
        print(__doc__.strip())


if __name__ == "__main__":
    try:
        main(sys.argv)
    except Exception:
        pass
    sys.exit(0)
